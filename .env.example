# ===========================================
# SaudiRecruit Environment Variables
# ===========================================
# Copy this file to .env.local and fill in values
# NEVER commit .env.local to git

# --- Database (Neon) ---
DATABASE_URL="postgresql://user:password@ep-xxx.us-east-1.aws.neon.tech/saudirecruit?sslmode=require"

# --- Authentication (NextAuth.js) ---
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="" # Generate: openssl rand -base64 32

# --- Email (Resend) ---
RESEND_API_KEY=""
EMAIL_FROM="noreply@yourdomain.com"

# --- File Storage (Cloudflare R2) ---
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME="saudirecruit-uploads"
R2_PUBLIC_URL=""

# --- Queue (QStash by Upstash) ---
QSTASH_TOKEN=""
QSTASH_CURRENT_SIGNING_KEY=""
QSTASH_NEXT_SIGNING_KEY=""

# --- App Config ---
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="SaudiRecruit"
